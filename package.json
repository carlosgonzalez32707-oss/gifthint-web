{
  "name": "gifthint",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev":       "turbo dev",
    "build":     "turbo build",
    "test":      "turbo test",
    "lint":      "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web":    "turbo dev --filter=@gifthint/web",
    "dev:mobile": "turbo dev --filter=@gifthint/mobile",
    "build:web":  "turbo build --filter=@gifthint/web"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "packageManager": "npm@10.8.1",
  "engines": {
    "node": ">=20"
  }
}
