# ─────────────────────────────────────────────────────────────────────────────
# GiftHint web app — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# PHASE HISTORY
# ─────────────
# Phase 1  Supabase, Stripe (group-gift), Resend email, Google OAuth, App URL
# Phase 2  Upstash Redis (rate-limit), Amazon Associates PA API, Skimlinks,
#          Sentry error monitoring, Chrome Store URL
# Phase 3  Stripe billing (Pro subscription), Admin secrets, Cron secret
#
# STARTUP VALIDATION
# ──────────────────
# app/startup-check.ts validates all REQUIRED vars on server cold-start.
# Call validateEnv() from app/layout.tsx to surface misconfiguration immediately.
# Variables marked [optional] cause feature degradation, never a startup crash.
#
# REQUIRED vs OPTIONAL
# ─────────────────────
# [required]  App will not start without this value
# [optional]  Feature degrades gracefully; app still starts
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server-side only — NOT exposed to the browser) ──────────────────
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: override the default 10-second Supabase query timeout.
# Useful on slow CI runners or when running batch cron jobs.
# SUPABASE_TIMEOUT_MS=10000

# ── Supabase (browser-safe — NEXT_PUBLIC_ prefix exposes to client bundle) ────
# Use the anon/public key here, NOT the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL used for generating canonical links and OG URLs.
# In development: http://localhost:3000
# In production:  https://gifthint.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chrome Web Store extension URL.
# Update this once the extension is published and you have the extension ID.
# All "Install Extension" CTAs on the landing pages and dashboard read from
# this single variable (app/page.tsx, app/gifts/page.tsx,
# app/gifts/[occasion]/page.tsx, app/dashboard/[slug]/page.tsx).
# Format: https://chromewebstore.google.com/detail/<extension-name>/<extension-id>
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/gifthint/PLACEHOLDER

# ── Affiliate ─────────────────────────────────────────────────────────────────
# Amazon Associates tag — server-side only, never exposed to the browser.
# Found in: Amazon Associates dashboard → Account Settings → Tracking ID
# Format: yoursite-XX (e.g. gifthint-20 for US, gifthint-21 for UK)
# Leave blank in development — links will still work, just without attribution.
AMAZON_ASSOCIATES_TAG=gifthint-20

# Amazon Product Advertising API credentials — server-side only.
# Used by lib/price-checker.ts to fetch live product prices via the PA API.
# NOT used for earnings reports (Amazon has no public earnings API).
#
# How to get these:
#   1. You must have qualifying sales (≥3 in 180 days) to apply for PA API access.
#   2. Go to: Associates Central → Tools → Product Advertising API → Request Access
#   3. Once approved, sign in to aws.amazon.com with the same account.
#   4. IAM → Users → Create user → Attach policy: AmazonProductAdvertisingAPIAccess
#   5. Create access key under Security credentials → Access keys.
#
# Leave blank if PA API access has not been approved yet — price checks will
# be skipped and lib/price-checker.ts returns null for Amazon items.
#
# AMAZON_ACCESS_KEY / AMAZON_SECRET_KEY / AMAZON_PARTNER_TAG are shared by both
# lib/price-checker.ts (live product prices) and lib/amazon-associates-api.ts
# (PA API v5 product search / commission report signing). Only one set of
# credentials is needed — both files read the same variable names.
AMAZON_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
AMAZON_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AMAZON_PARTNER_TAG=gifthint-20

# Amazon Associates tag — browser-safe (appears in click-through URLs).
# Used by lib/retailer-search-urls.ts to build product search deep-links
# on the gifter page (client-side).  Must match AMAZON_ASSOCIATES_TAG above.
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=gifthint-20

# ── Admin ─────────────────────────────────────────────────────────────────────
# ADMIN_SECRET          — protects the /admin dashboard page
# ADMIN_REFUND_SECRET   — protects POST /api/group-gift/refund in admin mode
# ADMIN_EMAIL           — email shown / used in admin tooling
#
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace_with_strong_random_secret
ADMIN_REFUND_SECRET=replace_with_strong_random_secret
ADMIN_EMAIL=admin@yourdomain.com

# ── Email (development) ───────────────────────────────────────────────────────
# Set to "true" in development to skip Resend API calls entirely.
# All email functions will log to console instead of sending.
RESEND_TEST_MODE=true

# Skimlinks publisher ID — browser-safe (appears in the script URL, not secret).
# Found in: Skimlinks dashboard → Account → Publisher Settings → Publisher ID
# Leave blank in development to skip loading the script entirely.
NEXT_PUBLIC_SKIMLINKS_PUBLISHER_ID=123456

# Skimlinks publisher ID — server-side version.
# Used by lib/skimlinks-api.ts (commission API) and the gifter-page server
# component (app/list/[username]/[slug]/page.tsx) to pass the publisher ID
# to lib/affiliate.ts for URL rewriting.  Must match the NEXT_PUBLIC_ value.
SKIMLINKS_PUBLISHER_ID=123456

# Skimlinks API key — server-side only, never expose to the browser.
# Used by lib/skimlinks-api.ts to fetch confirmed commission data via the
# Skimlinks Publisher API v2.
#
# How to get this:
#   1. Log in to https://hub.skimlinks.com
#   2. Go to Account → API Access → Generate API Key
#   3. Also note your Publisher ID from Account → Publisher Settings
#
SKIMLINKS_API_KEY=your_skimlinks_api_key_here

# ── Email — Resend ────────────────────────────────────────────────────────────
# Resend (resend.com) handles transactional email.
# Free tier: 3,000 emails/month, 100/day — enough for early-stage.
#
# Setup:
#   1. Create a free account at https://resend.com
#   2. Add and verify your sending domain (e.g. gifthint.io) under Domains
#   3. Create an API key under API Keys and paste it here
#   4. Update the `from` address in lib/email.ts to match your verified domain
#
# In development you can use Resend's test domain:
#   from: 'GiftHint <onboarding@resend.dev>'
#   (only delivers to your own Resend-verified email address)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cron security ─────────────────────────────────────────────────────────────
# Secret that Vercel Cron attaches as "Authorization: Bearer <secret>" when
# calling /api/cron/send-reminders. The endpoint rejects requests without it.
#
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Copy the same value into your Vercel project environment variables so Vercel
# Cron can authenticate against your endpoint.
CRON_SECRET=replace_with_a_strong_random_secret_hex_string

# ── Sentry — Error Monitoring & Performance ───────────────────────────────────
# Sentry captures unhandled exceptions, performance traces, and Session Replays.
# Free plan covers 5k errors/month and 10k performance units — enough for early
# production. Upgrade to Team ($26/month) when you exceed that.
#
# Setup:
#   1. Create a project at https://sentry.io (choose "Next.js")
#   2. Copy the DSN from: Project Settings → Client Keys → DSN
#   3. Create an auth token at: Settings → Developer Settings → New Internal
#      Integration (needs project:write + org:read scopes)
#   4. Set SENTRY_ORG to your org slug (visible in the Sentry URL: sentry.io/orgs/<slug>/)
#   5. Set SENTRY_PROJECT to your project slug
#
# NEXT_PUBLIC_SENTRY_DSN  — exposed to the browser (client-side error capture)
# SENTRY_DSN              — server-side only (API routes, Server Components)
#   Both values are the same DSN string; the prefix controls visibility.
#
# SENTRY_AUTH_TOKEN       — server-only, used during build to upload source maps.
#   Never prefix with NEXT_PUBLIC_ — this would expose it in the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=gifthint
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis — Rate Limiting & IP Blocklist ──────────────────────────────
# Used by lib/rate-limit.ts (sliding-window rate limiting) and middleware.ts
# (global 500 req/IP/min guard + O(1) blocklist lookup).
#
# Upstash provides a serverless Redis compatible with Vercel Edge Functions —
# no persistent TCP connections, HTTP-based, works in Next.js middleware.
#
# Setup:
#   1. Create a free account at https://upstash.com
#   2. Create a new Redis database (choose a region close to your Vercel region)
#   3. Copy the REST URL and REST token from the database detail page
#
# Free tier: 10,000 commands/day — enough for development and early production.
# For 10k+ users enable the pay-as-you-go plan (~$0.2 per 100k commands).
#
# If these variables are unset the app fails open — rate limiting is skipped
# and no IPs are blocked (infrastructure failures never affect real users).
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXxx

# ── Stripe — Group Gifting ────────────────────────────────────────────────────
# ⚠️  STRIPE TEST MODE
# Use test-mode keys during development and staging. Test keys start with
# sk_test_ and pk_test_. Find them at:
#   https://dashboard.stripe.com/test/apikeys
#
# Test card numbers (no real money):
#   Success:  4242 4242 4242 4242  exp: any future date  CVC: any 3 digits
#   Decline:  4000 0000 0000 0002
#
# Switch to live keys (sk_live_ / pk_live_) only when going to production.
# NEVER commit live keys to version control.
#
# STRIPE_SECRET_KEY     — server-side only, never expose to the browser
# STRIPE_PUBLISHABLE_KEY — browser-safe (NEXT_PUBLIC_ prefix)
# STRIPE_WEBHOOK_SECRET  — from Stripe dashboard → Webhooks → your endpoint
#
# To set up the webhook locally:
#   1. Install Stripe CLI: brew install stripe/stripe-cli/stripe
#   2. Run: stripe listen --forward-to localhost:3000/api/group-gift/webhook
#   3. Copy the "webhook signing secret" it prints → paste below
STRIPE_SECRET_KEY=your_stripe_test_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# ── Stripe — Pro Subscription (GiftHint Billing) ──────────────────────────────
# This is a SEPARATE Stripe product from the group-gift payment flow.
#
# Setup (one-time, Stripe Dashboard):
#   1. Products → Add product
#      Name: "GiftHint Pro"
#      Pricing model: Recurring
#
#   2. Add two prices to the product:
#      a. Monthly — £4.99/month  (billing_scheme: per_unit, interval: month)
#      b. Annual  — £47.88/year  (billing_scheme: per_unit, interval: year)
#      Copy each price ID (price_xxx) to the vars below.
#
#   3. Register a NEW webhook endpoint in Stripe Dashboard → Webhooks:
#      URL: https://gifthint.io/api/billing/webhook
#      Events to send:
#        checkout.session.completed
#        customer.subscription.updated
#        customer.subscription.deleted
#        invoice.payment_failed
#      Copy the "Signing secret" (whsec_xxx) to STRIPE_BILLING_WEBHOOK_SECRET.
#
#   4. To test locally:
#      stripe listen --forward-to localhost:3000/api/billing/webhook \
#        --events checkout.session.completed,customer.subscription.updated,\
#                 customer.subscription.deleted,invoice.payment_failed
#      Paste the printed signing secret into STRIPE_BILLING_WEBHOOK_SECRET.
#
# STRIPE_PRO_MONTHLY_PRICE_ID  — server-side only (passed to Checkout Session)
# STRIPE_PRO_ANNUAL_PRICE_ID   — server-side only
# NEXT_PUBLIC_* variants       — browser-safe (used by app/dashboard/upgrade)
# STRIPE_BILLING_WEBHOOK_SECRET — different from STRIPE_WEBHOOK_SECRET above
STRIPE_PRO_MONTHLY_PRICE_ID=price_monthly_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_annual_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_monthly_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=price_annual_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_BILLING_WEBHOOK_SECRET=your_stripe_billing_webhook_signing_secret

# ── Google OAuth — Extension sign-in ─────────────────────────────────────────
# Used by app/api/auth/exchange/route.ts to exchange the OAuth authorisation
# code received from the Chrome extension for a Supabase session token.
# The extension sends the auth code via postMessage; this server route
# completes the PKCE flow server-side so GOOGLE_CLIENT_SECRET never ships
# in the extension bundle.
#
# How to get these:
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create → OAuth client ID → Web application
#   3. Add https://gifthint.io/api/auth/exchange as an authorised redirect URI
#   4. Copy Client ID and Client Secret below
#   5. Paste the same Client ID into extension/manifest.json → oauth2.client_id
#
GOOGLE_CLIENT_ID=987313469607-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Phase 4 — Mobile preparation (add before React Native app ships) ──────────
# These vars will be needed by the Expo / React Native app via Expo's
# environment configuration. They mirror the web vars but are consumed through
# expo-constants and react-native-dotenv rather than Next.js.
#
# React Native does NOT use NEXT_PUBLIC_ prefixes — those are Next.js conventions.
# For the shared API base URL, define it once here and reference it in both the
# web app and the RN app's environment config.
#
# NEXT_PUBLIC_APP_URL is already defined above and doubles as the API base URL
# that the React Native app will hit. No new vars required for the API layer
# itself — versioning (/api/v1/*) is handled at the routing level, not by env.
#
# Expo-specific vars to add here when Phase 4 begins:
#   EXPO_PUBLIC_API_URL=https://gifthint.io   # mirrors NEXT_PUBLIC_APP_URL
#   EXPO_PUBLIC_SUPABASE_URL=                 # same value as NEXT_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=            # same value as NEXT_PUBLIC_SUPABASE_ANON_KEY
#   EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=       # same value as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
